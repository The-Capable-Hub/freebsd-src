#
# GENERIC-MORELLO -- Generic kernel configuration file for Arm Morello platform
#

include "GENERIC"
include "std.CHERI"

makeoptions WITHOUT_CTF=1
makeoptions NO_MODULES=1

ident	GENERIC-MORELLO

nooptions	NFSCL
nooptions	NFSD
nooptions	VIMAGE
nodevice netmap
nodevice dpaa2

# weird -march
nodevice armv8crypto

# not yet
nooptions dtrace
nodevice vchiq
nodevice hyperv

# linuxkpi
nodevice mlxfw
nooptions COMPAT_LINUXKPI
nodevice mlx
nodevice mlx5
nodevice mlx5en
